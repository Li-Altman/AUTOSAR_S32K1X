/**********************************************************************************************************************
 *                                              P L E A S E   N O T E
 *
 * The attributes in this file must not be changed. Missing mandatory attributes must be set in the including file.
 * They are presented as a comment in the corresponding object definition containing a list of all legal values.
 *********************************************************************************************************************/

   TASK RunTask_OsCore0 {
      ACTIVATION = 1:"@RO@";
      PRIORITY = 20:"@RO@";
      SCHEDULE = FULL:"@RO@";
// TIMING_PROTECTION = FALSE|TRUE; (AUTOSAR OS only)
      AUTOSTART = FALSE:"@RO@";
      EVENT = Rte_Ev_Cyclic2_RunTask_OsCore0_0_10ms:"@RO@";
      EVENT = Rte_Ev_Cyclic2_RunTask_OsCore0_0_20ms:"@RO@";
      EVENT = Rte_Ev_Run_BswM_BswM_MainFunction:"@RO@";
   }:"@RO@@NR@";

   ALARM Rte_Al_TE2_RunTask_OsCore0_0_10ms {
      COUNTER = OsCounter;
      ACTION = SETEVENT
      {
         TASK = RunTask_OsCore0;
         EVENT = Rte_Ev_Cyclic2_RunTask_OsCore0_0_10ms;
      }:"@ROC@";
      AUTOSTART = FALSE:"@RO@";
   }:"@RO@@NR@";

   ALARM Rte_Al_TE2_RunTask_OsCore0_0_20ms {
      COUNTER = OsCounter;
      ACTION = SETEVENT
      {
         TASK = RunTask_OsCore0;
         EVENT = Rte_Ev_Cyclic2_RunTask_OsCore0_0_20ms;
      }:"@ROC@";
      AUTOSTART = FALSE:"@RO@";
   }:"@RO@@NR@";

   ALARM Rte_Al_TE_BswM_BswM_MainFunction {
      COUNTER = OsCounter;
      ACTION = SETEVENT
      {
         TASK = RunTask_OsCore0;
         EVENT = Rte_Ev_Run_BswM_BswM_MainFunction;
      }:"@ROC@";
      AUTOSTART = FALSE:"@RO@";
   }:"@RO@@NR@";

   EVENT Rte_Ev_Cyclic2_RunTask_OsCore0_0_10ms {
      MASK = AUTO;
   }:"@ROC@@NR@";

   EVENT Rte_Ev_Cyclic2_RunTask_OsCore0_0_20ms {
      MASK = AUTO;
   }:"@ROC@@NR@";

   EVENT Rte_Ev_Run_BswM_BswM_MainFunction {
      MASK = AUTO;
   }:"@ROC@@NR@";
