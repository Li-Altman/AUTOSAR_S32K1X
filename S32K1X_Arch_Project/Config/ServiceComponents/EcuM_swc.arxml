                      </POSSIBLE-ERROR-REFS>
                    </CLIENT-SERVER-OPERATION>
                    <CLIENT-SERVER-OPERATION UUID="02bc52bb-8bf5-40d4-aa70-ff7e09871005">
                      <SHORT-NAME>GetShutdownCause</SHORT-NAME>
                      <DESC>
                        <L-2 L="FOR-ALL">Returns the selected shutdown cause as set by the operation SelectShutdownCause.</L-2>
                      </DESC>
                      <ARGUMENTS>
                        <ARGUMENT-DATA-PROTOTYPE UUID="daf0b2d2-d44e-4d73-a665-510db3f0ef58">
